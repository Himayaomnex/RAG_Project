# ============================================================
# Environment Variables — Copy this to .env and fill in values
# ============================================================

# OpenRouter API key for LLM inference (get from openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# GitHub Personal Access Token (for github_mcp_client.py)
# Scope needed: repo (read-only is enough)
GITHUB_TOKEN=your_github_pat_here
